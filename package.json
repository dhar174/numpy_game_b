{
  "name": "numpy-nebula",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "predev": "npm run prepare:runtime",
    "dev": "vite --host 127.0.0.1",
    "serve": "vite preview --host 127.0.0.1 --port 4173",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prebuild": "npm run prepare:runtime",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:regression": "npm run build && node scripts/regression-check.js"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "pyodide": "0.26.3"
  }
}
